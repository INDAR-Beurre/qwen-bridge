# Server settings
PORT=3000

# Backend Mode: "qwen-code-oauth", "model-studio", or "puter"
QWEN_MODE=qwen-code-oauth

# Puter API Configuration (only needed for puter mode)
PUTER_AUTH_TOKEN=your-puter-auth-token-here

# Qwen Code CLI configuration (only needed for qwen-code-oauth mode)
# Path to the qwen CLI binary. Defaults to "qwen"
QWEN_BINARY=qwen

# Alibaba Cloud Model Studio API Configuration (only needed for model-studio mode)
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your-model-studio-api-key-here

# Fallback/Default Model ID
DEFAULT_MODEL=qwen3.6-plus

# Bearer Token for securing this bridge. Clients must pass: Authorization: Bearer <key>
BRIDGE_API_KEY=your-secure-bridge-api-key-here

# Comma-separated list of models returned by /v1/models
QWEN_MODELS=qwen3.5-plus,qwen3.6-plus,qwen3.5-coder,qwen-turbo,qwen-plus,qwen-max

# Toggle prompt logging (do not store prompts unless set to true)
LOG_PROMPTS=false
